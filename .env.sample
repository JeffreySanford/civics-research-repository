# Local development environment template.
# Copy to .env for local development.
#
# This repository currently targets local/demo development only.
#
# The persistent DSpace administrator already uses the credentials below.
# Editing this file does not update that account. Preserve the existing account and volume.
# .env is git-ignored; keep personal keys there, never in this template.

COMPOSE_PROJECT_NAME=civics-research-repository

# Sync behavior
CIVICS_SYNC_STARTUP_ENABLED=true
CIVICS_SYNC_MODE=APPLY
CIVICS_SYNC_SOURCE=TIGER_LINE

# Application database
CIVICS_DB_NAME=civics_ops
CIVICS_DB_USER=civics
CIVICS_DB_PASSWORD=civics

# Stable signing key for search navigation cursors (local development only).
CIVICS_SEARCH_CURSOR_SECRET=local-development-search-cursor-secret-change-me
# Container path to host-backed research evidence.
CIVICS_SEARCH_EVIDENCE_PATH=/var/lib/civics/research-evidence

# DSpace REST endpoint
CIVICS_DSPACE_BASE_URL=http://dspace-rest:8080/server

# DSpace administrator used by both repository reconciliation and initial seeding
CIVICS_DSPACE_ADMIN_EMAIL=admin@civics.local
CIVICS_DSPACE_ADMIN_PASSWORD=civics-admin

# data.gov API key.
# DEMO_KEY is suitable for bounded local/demo requests.
# Override in .env with a personal key for sustained harvesting.
CIVICS_FEDERATION_DATA_GOV_API_KEY=DEMO_KEY

# NASA CMR public collections need no bearer token; Client-Id identifies this tool.
CIVICS_FEDERATION_NASA_CMR_CLIENT_ID=civics-research-repository
CIVICS_FEDERATION_NASA_CMR_BEARER_TOKEN=
# PubMed keys are optional for bounded samples; email identifies the developer.
CIVICS_FEDERATION_PUBMED_API_KEY=
CIVICS_FEDERATION_PUBMED_EMAIL=
# OpenAlex keys are optional for bounded sampling. DOE OSTI needs no key.
CIVICS_FEDERATION_OPENALEX_API_KEY=

# Additional application settings for direct Java launches. Compose fixes service URLs/storage
# paths and does not forward these optional properties from .env. Export them for a direct launch.
CIVICS_SYNC_MAX_OBJECTS_PER_SOURCE=200
CIVICS_SOLR_BASE_URL=http://solr:8983/solr
CIVICS_SOLR_CORE=discovery
CIVICS_OPENSEARCH_BASE_URL=http://opensearch:9200
CIVICS_OPENSEARCH_INDEX=discovery-comparison
CIVICS_STORAGE_ARTIFACTS_PATH=/var/lib/civics/artifacts
CIVICS_CORPUS_ARCHIVES_PATH=/var/lib/civics/artifacts/corpus-archives

# Seed-script options for direct invocation / explicit `docker compose run -e NAME=value`.
# Compose does not forward these optional settings. Structure names must match seed-structure.xml.
DSPACE_SEED_ADMIN_FIRST=Civics
DSPACE_SEED_ADMIN_LAST=Administrator
DSPACE_SEED_COMMUNITY=Census Public Research Data
DSPACE_SEED_COLLECTION=TIGER/Line Geospatial Files

# Host-side tooling uses published ports, distinct from the API's internal DSpace endpoint.
# For direct Node scripts, load overrides with `node --env-file-if-exists=.env tools/scripts/NAME.mjs`
# or export them in the shell. Ordinary startup lets Compose read .env itself.
DSPACE_BASE_URL=http://localhost:8081/server
CIVICS_API_URL=http://localhost:8080/api
CIVICS_UI_URL=http://localhost:4200
CIVICS_MOBILE_UI_URL=http://localhost:4300
CIVICS_EVIDENCE_API_URL=http://localhost:8080/api
CIVICS_EVIDENCE_OUTPUT=browser-evidence-artifacts/dspace-provenance-idempotence.json
CIVICS_EVIDENCE_READBACK_OUTPUT=browser-evidence-artifacts/dspace-provenance-readback.json
CIVICS_LINEAGE_EVIDENCE_OUTPUT=browser-evidence-artifacts/dspace-version-lineage.json
DSPACE_LINEAGE_WAIT_TIMEOUT_MS=60000
DSPACE_LINEAGE_WAIT_INTERVAL_MS=1000
DSPACE_WAIT_TIMEOUT_MS=90000
DSPACE_WAIT_INTERVAL_MS=2000
