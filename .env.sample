# Copy to .env for local development. .env is git-ignored; this sample is committed.
#
# The values below are fictitious local-demo credentials. They are not secrets and are not used by
# any deployed environment — they exist only so a fresh Docker stack can seed a DSpace administrator
# and then authenticate against it. Copying this file as-is produces a working local stack, because
# the DSpace seed job creates the administrator using these same variables.

COMPOSE_PROJECT_NAME=civics-research-repository

# Sync behavior. Startup sync is skipped automatically when DSpace is unreachable, so APPLY is
# safe as the default: it only runs against a live repository, and it is idempotent. Use DRY_RUN
# here if you want startup to plan without writing.
CIVICS_SYNC_STARTUP_ENABLED=true
CIVICS_SYNC_MODE=APPLY
CIVICS_SYNC_SOURCE=TIGER_LINE

# Application database (repository-api operational state: sync jobs).
# Distinct from the DSpace database, which DSpace owns and names `dspace`.
CIVICS_DB_NAME=civics_ops
CIVICS_DB_USER=civics
CIVICS_DB_PASSWORD=civics

# Search continuation tokens are navigation state, not authorization, but the application signs them
# so callers cannot edit engine-native cursor positions or their request/projection binding. Use a
# stable random value in deployed environments; changing it intentionally invalidates outstanding
# cursors. This sample value is local-development-only.
CIVICS_SEARCH_CURSOR_SECRET=local-development-search-cursor-secret-change-me

# -----------------------------------------------------------------------------
# Federated public-metadata sources
# -----------------------------------------------------------------------------
# Never commit real API keys or bearer tokens. The initial all-source sampler is deliberately small;
# credentials marked optional may be left blank for public-only sampling.

# Data.gov Catalog API v4 — REQUIRED for meaningful harvesting beyond tiny exploratory requests.
# Host-side research commands load repo-local .env automatically when it exists; an already-exported
# environment value takes precedence. Copy this sample to .env and replace the placeholder with your
# own api.data.gov key to reproduce sustained/certified evidence runs. DEMO_KEY remains the Docker
# Compose fallback only so a fresh container stack can make a trivial bounded request.
CIVICS_FEDERATION_DATA_GOV_API_KEY=YOUR_API_DATA_GOV_KEY_HERE

# DOE OSTI.GOV — no API key is required for the public records API.

# NASA Earthdata CMR — public collection metadata requires no Earthdata token. Client-Id is sent on
# every request because CMR recommends a stable client identity. Add a bearer token only if future
# research intentionally includes protected holdings; the initial sampler should leave it blank.
CIVICS_FEDERATION_NASA_CMR_CLIENT_ID=civics-research-repository
CIVICS_FEDERATION_NASA_CMR_BEARER_TOKEN=

# PubMed / NCBI E-utilities — API key is OPTIONAL for the small live sample but RECOMMENDED for any
# sustained API use (higher supported request rate). NCBI also recommends identifying the tool and
# developer email; the application supplies its tool name automatically.
CIVICS_FEDERATION_PUBMED_API_KEY=
CIVICS_FEDERATION_PUBMED_EMAIL=

# OpenAlex Works API — key is OPTIONAL for casual sampling but RECOMMENDED for normal API research.
# Large 10M/100M tiers should use a pinned public OpenAlex S3 snapshot instead of crawling the API.
CIVICS_FEDERATION_OPENALEX_API_KEY=

# DSpace REST endpoint used by the Java API
CIVICS_DSPACE_BASE_URL=http://dspace-rest:8080/server

# DSpace administrator. The seed job (tools/dspace/seed-structure.sh) creates this account, and the
# Java API authenticates with it to reconcile item metadata. Leave both blank to run diff-only with
# DSpace writes disabled.
CIVICS_DSPACE_ADMIN_EMAIL=admin@civics.local
CIVICS_DSPACE_ADMIN_PASSWORD=local-demo-not-a-secret

# The seed job creates the administrator above; keep these aligned with the two variables above.
DSPACE_SEED_ADMIN_EMAIL=admin@civics.local
DSPACE_SEED_ADMIN_PASSWORD=local-demo-not-a-secret
