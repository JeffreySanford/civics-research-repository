{
  "name": "discovery-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/discovery-ui/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/discovery-ui",
        "browser": "apps/discovery-ui/src/main.ts",
        "tsConfig": "apps/discovery-ui/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/discovery-ui/public"
          },
          {
            "glob": "maplibre-gl-worker.mjs",
            "input": "node_modules/maplibre-gl/dist",
            "output": "."
          },
          {
            "glob": "maplibre-gl-shared.mjs",
            "input": "node_modules/maplibre-gl/dist",
            "output": "."
          }
        ],
        "styles": ["apps/discovery-ui/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/discovery-ui/src/environments/environment.ts",
              "with": "apps/discovery-ui/src/environments/environment.production.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "480kb",
              "maximumError": "560kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "12kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "storybook": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": false
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "prebundle": {
          "exclude": ["maplibre-gl"]
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "discovery-ui:build:production"
        },
        "development": {
          "buildTarget": "discovery-ui:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "discovery-ui:build",
        "port": 4200,
        "staticFilePath": "dist/apps/discovery-ui/browser",
        "spa": true
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "apps/discovery-ui/.storybook",
        "browserTarget": "discovery-ui:build:storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/discovery-ui",
        "configDir": "apps/discovery-ui/.storybook",
        "browserTarget": "discovery-ui:build:storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c apps/discovery-ui/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "discovery-ui:build-storybook",
        "staticFilePath": "dist/storybook/discovery-ui",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "discovery-ui:build-storybook:ci"
        }
      }
    },
    "test-coverage": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "coverage": true,
        "coverageReporters": ["text-summary", "json-summary", "lcov"],
        "coverageThresholds": {
          "statements": 69,
          "branches": 67,
          "functions": 65,
          "lines": 70
        }
      }
    }
  }
}
