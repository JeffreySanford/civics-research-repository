{
  "name": "discovery-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/discovery-ui/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/discovery-ui",
        "browser": "apps/discovery-ui/src/main.ts",
        "tsConfig": "apps/discovery-ui/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/discovery-ui/public"
          },
          {
            "glob": "maplibre-gl-worker.mjs",
            "input": "node_modules/maplibre-gl/dist",
            "output": "."
          },
          {
            "glob": "maplibre-gl-shared.mjs",
            "input": "node_modules/maplibre-gl/dist",
            "output": "."
          }
        ],
        "styles": ["apps/discovery-ui/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/discovery-ui/src/environments/environment.ts",
              "with": "apps/discovery-ui/src/environments/environment.production.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "12kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "prebundle": {
          "exclude": ["maplibre-gl"]
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "discovery-ui:build:production"
        },
        "development": {
          "buildTarget": "discovery-ui:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "discovery-ui:build",
        "port": 4200,
        "staticFilePath": "dist/apps/discovery-ui/browser",
        "spa": true
      }
    }
  }
}
