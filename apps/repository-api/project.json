{
  "name": "repository-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/repository-api/src/main/java",
  "tags": ["type:api", "runtime:java"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/repository-api/Dockerfile --target runtime -t civics-repository-api:local ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/repository-api/Dockerfile --target test ."
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up repository-api"
      }
    },
    "sync": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose run --rm repository-api --spring.main.web-application-type=none --civics.sync.cli-enabled=true --civics.sync.mode=DRY_RUN --civics.sync.source=TIGER_LINE"
      },
      "configurations": {
        "diff": {
          "command": "docker compose run --rm repository-api --spring.main.web-application-type=none --civics.sync.cli-enabled=true --civics.sync.mode=DIFF --civics.sync.source=TIGER_LINE"
        },
        "apply": {
          "command": "docker compose run --rm repository-api --spring.main.web-application-type=none --civics.sync.cli-enabled=true --civics.sync.mode=APPLY --civics.sync.source=TIGER_LINE"
        }
      }
    }
  }
}
