{
  "name": "civics-research-repository",
  "version": "0.1.0",
  "private": true,
  "description": "Federal open-science repository and mapping visualization demo using Nx, Angular, Material Design, DSpace, Solr, PostgreSQL, Census public data, and USGS overlays.",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "brace-expansion": "5.0.9",
      "postcss": "8.5.26",
      "uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "nx"
    ]
  },
  "scripts": {
    "nx": "nx",
    "dev": "pnpm run start:all",
    "start": "pnpm nx run discovery-ui:serve",
    "demo:up": "node tools/scripts/demo.mjs",
    "demo:down": "node tools/scripts/demo.mjs --down",
    "start:all": "node tools/scripts/stack.mjs",
    "start:all:attach": "node tools/scripts/stack.mjs --attach",
    "start:all:detached": "node tools/scripts/stack.mjs",
    "start:all:recreate": "node tools/scripts/stack.mjs --recreate",
    "start:all:rebuild": "node tools/scripts/stack.mjs --rebuild",
    "start:ui": "pnpm nx run discovery-ui:serve",
    "start:api": "pnpm nx run repository-api:serve",
    "docker:up": "docker compose up",
    "docker:up:detached": "docker compose up -d",
    "docker:down": "node tools/scripts/stack.mjs --stop",
    "docker:logs": "docker compose logs --tail=200",
    "docker:ps": "docker compose ps",
    "docker:reset:containers": "node tools/scripts/stack.mjs --reset",
    "docker:reset:everything": "docker compose --profile dspace down --remove-orphans --volumes",
    "dspace:up": "docker compose --profile dspace up dspace-rest",
    "dspace:up:detached": "docker compose --profile dspace up -d dspace-rest",
    "dspace:migrate": "docker compose --profile dspace run --rm dspace-db-init",
    "dspace:saf:generate": "node tools/scripts/generate-saf.mjs",
    "dspace:seed": "node tools/scripts/generate-saf.mjs && docker compose --profile dspace run --rm dspace-seed",
    "dspace:ps": "docker compose --profile dspace ps dspace-rest dspace-db-init dspace-seed dspace-postgres dspace-solr dspace-solr-init",
    "dspace:logs": "docker compose --profile dspace logs --tail=200 dspace-rest dspace-db-init dspace-seed dspace-postgres dspace-solr dspace-solr-init",
    "dspace:down": "docker compose --profile dspace stop dspace-rest dspace-db-init dspace-seed dspace-postgres dspace-solr dspace-solr-init",
    "dspace:reset:containers": "docker compose --profile dspace rm -sf dspace-rest dspace-db-init dspace-seed dspace-postgres dspace-solr dspace-solr-init",
    "dspace:verify": "curl -f http://localhost:8081/server/api",
    "dspace:verify:seed": "node tools/scripts/verify-dspace-seed.mjs",
    "opensearch:verify": "curl -f http://localhost:9200/_cluster/health",
    "sync:dry-run": "pnpm nx run repository-api:sync",
    "sync:diff": "pnpm nx run repository-api:sync:diff",
    "sync:apply": "pnpm nx run repository-api:sync:apply",
    "reindex": "curl -X POST http://localhost:8080/api/admin/reindex",
    "reindex:status": "curl http://localhost:8080/api/admin/reindex",
    "federation:harvest:datagov:1k": "curl -X POST http://localhost:8080/api/admin/federation/harvest/restart -H \"Content-Type: application/json\" -d \"{\\\"sourceSystem\\\":\\\"DATA_GOV\\\",\\\"pageSize\\\":100,\\\"maxPages\\\":10}\"",
    "sync:api:dry-run": "curl -X POST http://localhost:8080/api/admin/sync -H \"Content-Type: application/json\" -d \"{\\\"mode\\\":\\\"DRY_RUN\\\",\\\"source\\\":\\\"TIGER_LINE\\\"}\"",
    "sync:api:diff": "curl -X POST http://localhost:8080/api/admin/sync -H \"Content-Type: application/json\" -d \"{\\\"mode\\\":\\\"DIFF\\\",\\\"source\\\":\\\"TIGER_LINE\\\"}\"",
    "sync:api:apply": "curl -X POST http://localhost:8080/api/admin/sync -H \"Content-Type: application/json\" -d \"{\\\"mode\\\":\\\"APPLY\\\",\\\"source\\\":\\\"TIGER_LINE\\\"}\"",
    "graph": "nx graph",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "affected": "nx affected",
    "build": "pnpm nx run discovery-ui:build",
    "build:all": "pnpm nx run-many -t build --all",
    "lint": "pnpm nx run-many -t lint --all",
    "openapi:lint": "pnpm exec redocly lint --config=.redocly.yaml schemas/openapi/repository-api.yaml",
    "openapi:generate": "pnpm exec openapi-typescript schemas/openapi/repository-api.yaml -o libs/repository/api-client/src/generated/repository-api.types.ts && pnpm exec prettier --write libs/repository/api-client/src/generated/repository-api.types.ts",
    "openapi:check": "node tools/scripts/check-openapi-generated.mjs",
    "test": "pnpm nx run discovery-ui:test",
    "test:all": "pnpm nx run-many -t test --all",
    "performance:test": "node --test tools/scripts/search-comparison-benchmark.test.mjs",
    "performance:benchmark": "node tools/scripts/search-comparison-benchmark.mjs",
    "e2e": "pnpm nx run discovery-ui-e2e:e2e",
    "storyboard": "pnpm nx run discovery-ui-e2e:storyboard",
    "accessibility": "pnpm nx run-many -t accessibility",
    "wcag": "pnpm nx run-many -t wcag",
    "wcag:report": "pnpm exec playwright test --config=apps/discovery-ui-e2e/playwright.config.mts --grep @wcag --reporter=list",
    "a11y:components": "pnpm exec nx test discovery-ui --filter=accessibility",
    "section508": "pnpm nx run-many -t section508",
    "section508:report": "pnpm exec playwright test --config=apps/discovery-ui-e2e/playwright.config.mts --grep @section508 --reporter=list",
    "e2e:reports": "node tools/scripts/e2e-reports.mjs",
    "evidence:generate": "node tools/scripts/accessibility-evidence.mjs",
    "evidence:refresh": "node tools/scripts/accessibility-evidence.mjs --refresh",
    "evidence:check": "node tools/scripts/accessibility-evidence.mjs --check",
    "docs:status": "node tools/scripts/platform-status.mjs",
    "docs:check": "node tools/scripts/platform-status.mjs --check",
    "fixture:check": "node tools/scripts/check-fixture-catalog.mjs",
    "verify:vintages": "node tools/scripts/check-catalog-vintages.mjs",
    "dspace:mirror": "node tools/scripts/mirror-source-files.mjs",
    "dspace:seed:mirrored": "node tools/scripts/generate-saf.mjs && node tools/scripts/mirror-source-files.mjs && docker compose --profile dspace run --rm dspace-seed",
    "sources:inventory": "node tools/scripts/build-source-inventory.mjs",
    "verify:sources": "node tools/scripts/verify-source-urls.mjs",
    "verify:sources:all": "node tools/scripts/verify-source-urls.mjs --all",
    "catalog:harvest": "node tools/scripts/harvest-catalog.mjs",
    "quality:all": "pnpm run format:check && pnpm run openapi:lint && pnpm run openapi:check && pnpm run fixture:check && pnpm run evidence:check && pnpm run docs:check && pnpm run performance:test && pnpm run lint && pnpm run test:all && pnpm run build:all && pnpm run e2e:reports"
  },
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/router": "22.1.1",
    "@ngrx/effects": "22.0.0-rc.0",
    "@ngrx/entity": "22.0.0-rc.0",
    "@ngrx/router-store": "22.0.0-rc.0",
    "@ngrx/signals": "22.0.0-rc.0",
    "@ngrx/store": "22.0.0-rc.0",
    "@ngrx/store-devtools": "22.0.0-rc.0",
    "maplibre-gl": "^6.3.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.7.0",
    "@analogjs/vitest-angular": "~2.7.0",
    "@angular-devkit/core": "22.1.3",
    "@angular-devkit/schematics": "22.1.3",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.54.0",
    "@redocly/cli": "2.46.1",
    "@schematics/angular": "22.1.3",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.1.0",
    "axe-core": "4.13.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "nx": "23.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "~3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  }
}
